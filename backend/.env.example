# PrognosysAI Backend Environment Configuration
PROJECT_NAME="PrognosysAI"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# Default to SQLite for zero-setup local dev; use PostgreSQL in production or Docker
DATABASE_URL="sqlite:///./prognosys.db"
# Example PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/prognosys

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Grounded AI Investigator (Optional; system falls back to deterministic templates if empty)
OPENAI_API_KEY=""
